{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "material-batch/1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "engine": {
            "type": "string",
            "enum": [
              "finance",
              "rights",
              "contracts",
              "certificates",
              "business"
            ]
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pdf",
                "docx",
                "png",
                "svg",
                "xlsx",
                "csv"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "pdf_mode": {
            "type": "string",
            "enum": [
              "searchable",
              "image"
            ]
          },
          "appearance": {
            "type": "string",
            "enum": [
              "digital",
              "scan"
            ]
          },
          "payload": {
            "type": "object",
            "description": "对应工作台完整方案及选中的材料范围；结构见get_capabilities和get_template"
          }
        },
        "required": [
          "document_id",
          "revision",
          "title",
          "engine",
          "formats",
          "payload"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "name",
    "documents"
  ],
  "additionalProperties": false
}
